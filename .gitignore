# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Yelp dataset — too large for git
data/Yelp JSON/
data/*.tar
data/*.tar.gz

# Zillow ZIP file — 116MB, re-downloaded by CI
data/Zip_zhvi_*.csv

# Large analysis outputs — reproducible by running scripts
data/full_merged.csv
data/merged_analysis.csv

# Nova snapshots tracked in git (small JSON)
!data/nova_snapshots/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
